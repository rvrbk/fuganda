APP_NAME=Verbeek.ug Real Estates
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost
FRONTEND_URL=http://localhost:5173

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost,localhost:5173,127.0.0.1,127.0.0.1:8000,mycanopy.verbeek.ug,api.mycanopy.verbeek.ug

# Sanctum Personal Access Client Configuration (for external API consumers)
SANCTUM_PERSONAL_ACCESS_CLIENT_ENABLED=true
PERSONAL_ACCESS_CLIENT_ID=
PERSONAL_ACCESS_CLIENT_SECRET=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=
RESEND_KEY=

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=${APP_URL}/auth/google/callback

# Demo/Test Mode - When enabled (true), allows anyone to register and create properties
# without requiring a seller subscription. Useful for testing and populating the platform.
# Set to "true" to enable, "false" or omit to disable.
DEMO_MODE=false

# Mobile Money Configuration
MOBILE_MONEY_DEFAULT_PROVIDER=mtn
MOBILE_MONEY_WEBHOOK_SECRET=
SUBSCRIPTION_GRACE_PERIOD_DAYS=7

# MTN MoMo API Configuration (Sandbox by default)
# Register at: momodeveloper.mtn.com
# Sandbox base URL: sandbox.momodeveloper.mtn.com
# Production base URL: momodeveloper.mtn.com
MTN_MOMO_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_MOMO_PRODUCTION_BASE_URL=https://momodeveloper.mtn.com
MTN_MOMO_API_USER=placeholder_api_user
MTN_MOMO_API_KEY=placeholder_api_key
MTN_MOMO_MERCHANT_CODE=placeholder_merchant_code
MTN_MOMO_SUBSCRIPTION_KEY=placeholder_subscription_key
MTN_MOMO_CALLBACK_URL=${APP_URL}/api/callbacks/mtn-momo
MTN_MOMO_WEBHOOK_SECRET=

# Airtel Money API Configuration
# Register at: developers.airtel.africa
AIRTEL_MONEY_BASE_URL=https://openapi.airtel.africa
AIRTEL_MONEY_CLIENT_ID=placeholder_client_id
AIRTEL_MONEY_CLIENT_SECRET=placeholder_client_secret
AIRTEL_MONEY_MERCHANT_CODE=placeholder_merchant_code
AIRTEL_MONEY_CALLBACK_URL=${APP_URL}/api/callbacks/airtel-money
AIRTEL_MONEY_WEBHOOK_SECRET=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
